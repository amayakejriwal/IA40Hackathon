{
  "name": "ia40-digitizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "dev:phone": "node scripts/dev-phone.mjs",
    "dev:usb": "node scripts/dev-phone.mjs --usb"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@openai/agents": "^0.18.0",
    "drizzle-orm": "^0.45.3",
    "mammoth": "^1.13.0",
    "nanoid": "^5.1.16",
    "next": "16.3.7",
    "openai": "^7.25.0",
    "pdfkit": "^0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
