#!/usr/bin/env python3
"""blank <image>... → ink coverage per image; below ~0.5% is almost certainly a blank page or separator back."""
import sys
from PIL import Image, ImageOps
for p in sys.argv[1:]:
    im = ImageOps.grayscale(Image.open(p)).resize((400, 520))
    ink = sum(1 for v in (im.get_flattened_data() if hasattr(im, "get_flattened_data") else im.getdata()) if v < 128) / (400 * 520)
    print(f"{ink*100:6.2f}%  {p}")
